# Copy this file to .env for Docker Compose. Do not commit .env.
MD_APP_MODE=demo
MD_ALLOW_GUEST_UPLOADS=true
MD_GUEST_TTL_SECONDS=86400
# Generate locally: python -c "import secrets; print(secrets.token_hex(32))"
MD_SESSION_SECRET=
# Local Docker over http: false. Public HTTPS: true.
MD_COOKIE_SECURE=false
MD_PUBLIC_ORIGIN=http://localhost:8080
# Change mode to private after configuring Supabase Auth.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
